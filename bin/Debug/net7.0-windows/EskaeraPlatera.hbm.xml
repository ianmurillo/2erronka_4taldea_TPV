<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                  assembly="2taldea"
                  namespace="_2taldea">

	<class name="EskaeraPlatera" table="eskaera_platera">
		<id name="Id" column="id" type="int">
			<generator class="identity"/>
		</id>

		<!-- Relación many-to-one con Eskaera -->
		<many-to-one name="Eskaera" column="eskaera_id" class="_2taldea.Eskaera" not-null="true"/>

		<!-- Relación many-to-one con Platera -->
		<many-to-one name="Platera" column="platera_id" class="_2taldea.Platera" not-null="true"/>

		<!-- Otros campos -->
		<property name="NotaGehigarriak" column="nota_gehigarriak" type="string"/>
		<property name="EskaeraOrdua" column="eskaera_ordua" type="timestamp"/>
		<property name="AteratzeOrdua" column="ateratze_ordua" type="timestamp"/>
		<property name="Egoera" column="egoera" type="boolean"/>
		<property name="Done" column="done" type="boolean"/>
	</class>

</hibernate-mapping>
