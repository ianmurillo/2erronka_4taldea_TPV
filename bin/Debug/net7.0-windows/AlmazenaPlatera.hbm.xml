<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="2taldea"
                   namespace="_2taldea">

	<class name="AlmazenaPlatera" table="almazena_platera">
		<id name="Id" column="id" type="int">
			<generator class="identity" />
		</id>

		<property name="Kantitatea" column="kantitatea" type="int" />

		<many-to-one name="Platera" column="platera_id" class="Platera" not-null="true" />
		<many-to-one name="Almazena" column="almazena_id" class="Almazena" not-null="true" />
	</class>
</hibernate-mapping>