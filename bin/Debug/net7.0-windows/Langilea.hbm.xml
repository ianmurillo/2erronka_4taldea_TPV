<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="2taldea"
                   namespace="_2taldea">

	<class name="Langilea" table="langilea">
		<id name="Id" column="id" type="int">
			<generator class="identity" />
		</id>

		<property name="Izena" column="izena" type="string" />
		<property name="Abizena" column="abizena" type="string" />
		<property name="Pasahitza" column="pasahitza" type="string" />
		<property name="Email" column="email" type="string" />
		<property name="NivelPermisos" column="nivel_permisos" type="int" />
		<property name="CreatedAt" column="created_at" type="timestamp" />
		<property name="UpdatedAt" column="updated_at" type="timestamp" />
		<property name="DeletedAt" column="deleted_at" type="timestamp" />
		<property name="TxatBaimena" column="txat_baimena" type="boolean" />
	</class>
</hibernate-mapping>
