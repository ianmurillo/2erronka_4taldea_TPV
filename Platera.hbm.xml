<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="2taldea"
                   namespace="_2taldea">

	<class name="Platera" table="platera">
		<id name="Id" column="id" type="int">
			<generator class="identity" />
		</id>

		<property name="Izena" column="izena" type="string" />
		<property name="Deskribapena" column="deskribapena" type="string" />
		<property name="Mota" column="mota" type="string" />
		<property name="PlateraMota" column="platera_mota" type="string" />
		<property name="Prezioa" column="prezioa" type="double" />
		<property name="Menu" column="menu" type="int" />
		<property name="CreatedAt" column="created_at" type="string" />
		<property name="CreatedBy" column="created_by" type="int" />
		<property name="UpdatedAt" column="updated_at" type="string" />
		<property name="UpdatedBy" column="updated_by" type="int" />
		<property name="DeletedAt" column="deleted_at" type="string" />
		<property name="DeletedBy" column="deleted_by" type="int" />
	</class>
</hibernate-mapping>
